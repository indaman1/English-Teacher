# Copy this file to .env.local and fill in the two values below.
# These are the ONLY variables the browser needs.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# SERVER-SIDE SECRETS: never put these in .env.local or in Vercel.
# Set them with: supabase secrets set NAME=value
# GEMINI_API_KEY=YOUR_GEMINI_KEY
# ALLOWED_ORIGIN=https://your-app.vercel.app
# GEMINI_LIVE_MODEL=
# GEMINI_TEXT_MODEL=
# GEMINI_VOICE_NAME=
